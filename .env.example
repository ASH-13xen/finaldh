# ============================================================================
# finaldh backend environment. Copy to `.env` and fill in real values.
# (Your production host already has these — pull them from there.)
# ============================================================================

# --- Core (you already have these) ---
PORT=5000
JWT_SECRET=change-me
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# --- Local dev bypass: set to true to enable the "Continue as developer" button
#     on the login screen (calls POST /api/auth/mock). NEVER set in production. ---
ALLOW_DEV_LOGIN=true

# --- Login: REQUIRED for real Google sign-in ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
# The OAuth client's "Authorized JavaScript origins" must include the origin you
# open the app on locally, e.g. http://localhost:5173 (Vite dev) and/or
# http://localhost:5000.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# --- Admin access: your Google account email(s). Without this you log in as a
#     normal student and won't see the admin tabs (incl. Toppers Copy Data). ---
ADMIN_EMAIL=you@gmail.com
ADMIN_EMAIL1=
ADMIN_EMAIL2=

# --- Cloudflare R2 (PDF storage) — needed for courses AND Toppers Copy ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- AI provider (Toppers Copy ingestion + existing extraction features) ---
AI_PROVIDER=gemini              # gemini | claude
AI_MODEL_GEMINI=gemini-3.5-flash
AI_MODEL_CLAUDE=claude-opus-5
GEMINI_API_KEY=                 # required if AI_PROVIDER=gemini
ANTHROPIC_API_KEY=              # required if AI_PROVIDER=claude

# --- GitHub PDF-processing workflow (only if you use that feature) ---
GITHUB_PAT=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_CALLBACK_SECRET=
CALLBACK_SECRET=
BACKEND_URL=http://localhost:5000
DOWNLOAD_MODE=
